# Supabase Project Settings → API бөлімінен алынады.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Жаңа Supabase жобаларында anon key орнына publishable key берілуі мүмкін:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Тек серверде қолданылады. Браузерге жарияламаңыз.
SUPABASE_SERVICE_ROLE_KEY=
# Жаңа Supabase server key атауы қолданылса:
SUPABASE_SECRET_KEY=

# Gemini кілтін тек серверлік ортада сақтаңыз.
GEMINI_API_KEY=

# Қажет болса модельді ауыстыруға болады.
GEMINI_MODEL=gemini-2.5-flash
