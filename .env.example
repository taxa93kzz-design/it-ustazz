# Supabase Project Settings → API бөлімінен алынады.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Тек серверде қолданылады. Браузерге жарияламаңыз.
SUPABASE_SECRET_KEY=
# Жергілікті ортада http://localhost:3000, production-да нақты HTTPS домені.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini кілтін тек серверлік ортада сақтаңыз.
GEMINI_API_KEY=

# Қажет болса модельді ауыстыруға болады.
GEMINI_MODEL=gemini-2.5-flash
